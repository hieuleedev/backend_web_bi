{
  "name": "backend_web_bi",
  "version": "1.0.0",
  "description": "Backend API & Realtime Server for Bi Bi Fashion Boutique & Rental",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop backend-web-bi",
    "pm2:restart": "pm2 restart backend-web-bi",
    "pm2:logs": "pm2 logs backend-web-bi",
    "pm2:status": "pm2 status",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:init": "node db/migrate.js",
    "db:export": "node db/export.js",
    "db:import": "node db/import.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "socket.io",
    "supabase",
    "vietqr",
    "ecommerce",
    "fashion-rental"
  ],
  "author": "Bi Bi Fashion",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  }
}
